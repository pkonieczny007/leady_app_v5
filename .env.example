# Wzór pliku `.env` dla serwera. Skopiuj i uzupełnij NA SERWERZE:
#
#     cp .env.example .env && nano .env && chmod 600 .env
#
# Plik `.env` jest w .gitignore i ma tam zostać. Wartości poniżej to wzór,
# nie sekrety — prawdziwych nie wolno wpisać do repozytorium.

# ------------------------------------------------------------- obowiązkowe

# Podpisuje ciastko sesji. Domyślna wartość w kodzie („leady-v3-demo") leży
# na GitHubie — kto ją zna, podpisze sobie sesję koordynatora i wejdzie bez
# PIN-u. Wygeneruj własną NA SERWERZE:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PIN startowy jedynego konta koordynatora (4 cyfry). Domyślny w kodzie to
# „0000". Wpisz go tutaj w edytorze, nie poleceniem w konsoli — polecenie
# z PIN-em zostaje w historii powłoki. Po pierwszym logowaniu i tak zmień go
# w panelu /uzytkownicy; dopóki jest startowy, panel kont krzyczy czerwoną ramką.
PIN_KOORDYNATORA=

# ------------------------------------------------------------- po certyfikacie

# Włącza flagę Secure na ciastku sesji. USTAW DOPIERO PO certbocie — włączone
# na serwerze bez HTTPS oznacza „logowanie wraca w kółko na ekran logowania"
# i szukanie błędu tam, gdzie go nie ma.
#HTTPS=1

# ------------------------------------------------------------- czego NIE ustawiać

# PIN_SERWISOWY — jeden PIN wpuszcza bez wyboru osoby, na uprawnienia
# koordynatora. To klucz uniwersalny do bazy z telefonami i mailami dyrektorów
# szkół. Na profilu `prod` kod wymaga dodatkowo PIN_SERWISOWY_PROD=tak, więc
# przypadkiem się nie włączy — świadomie też nie.
