data/
__pycache__/
*.pyc
.venv/
venv/
*.log
_upload.xlsx
tmp/

# kopie zapasowe baz — pilnowane cronem, nie gitem
kopie/

# karty dostepu z PIN-ami - NIGDY do repozytorium
# (haslo do systemu z danymi osobowymi dyrektorow szkol)
dostepy/

# sekrety serwera: SECRET_KEY i PIN koordynatora. Na VPS repozytorium jest
# klonem gita, wiec `git add .` bez tej linii wypchnaloby je na GitHuba.
# Wzor bez wartosci zostaje w .env.example
.env

# Pliki robocze klienta w katalogach poprawek — kopie jego arkuszy z danymi
# osobowymi i stawkami trenerów. Repozytorium jest PUBLICZNE, a git nie
# zapomina historii: raz wypchnięty plik zostaje tam także po skasowaniu.
# Notatki tekstowe i projekty zostają w repo, arkusze klienta nie.
docs/poprawka */**/Kopia *.xlsx
docs/poprawka */**/PH *.xlsx
